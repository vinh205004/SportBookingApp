<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/btnBackConfirm"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#333333"
            android:contentDescription="Quay lại"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Xác nhận đặt sân"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginEnd="32dp"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutHeader"
        android:layout_above="@id/layoutBottom"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Chi tiết đặt sân -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:text="Chi tiết đặt sân"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Tên sân -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                        <TextView android:text="Sân:" android:layout_width="80dp" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/tvCourtNameConfirm" android:text="Sân bóng Thanh Xuân" android:textStyle="bold" android:textColor="#000000" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Địa chỉ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <TextView android:text="Địa chỉ:" android:layout_width="80dp" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/tvCourtAddressConfirm" android:text="123 Nguyễn Trãi..." android:textColor="#616161" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Ngày -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <TextView android:text="Ngày:" android:layout_width="80dp" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/tvDateConfirm" android:text="20/07/2024" android:textColor="#000000" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Giờ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <TextView android:text="Giờ:" android:layout_width="80dp" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/tvTimeConfirm" android:text="19:00 - 20:00" android:textStyle="bold" android:textColor="#000000" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginVertical="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tổng tiền:"
                                android:textColor="#2196F3"
                                android:textStyle="bold"
                                android:textSize="16sp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1"/>

                            <TextView
                                android:id="@+id/tvTotalPriceConfirm"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="150.000 VNĐ"
                                android:textColor="#2196F3"
                                android:textStyle="bold"
                                android:textSize="18sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDiscountMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="#FFEBEE"
                            android:padding="8dp"
                            android:text="🎉 Chúc mừng! Bạn đang đặt đơn thứ 6. Giảm ngay 20%!"
                            android:textColor="#D32F2F"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:visibility="gone" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. Thông tin người đặt -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:text="Thông tin người đặt"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Tên của bạn"
                        android:textSize="12sp"
                        android:layout_marginTop="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <EditText
                        android:id="@+id/edtUserName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_chip_gray"
                        android:paddingHorizontal="12dp"
                        android:text="Nguyen Van A"
                        android:textSize="14sp"
                        android:inputType="textPersonName"/>

                    <TextView
                        android:text="Số điện thoại"
                        android:textSize="12sp"
                        android:layout_marginTop="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <EditText
                        android:id="@+id/edtUserPhone"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_chip_gray"
                        android:paddingHorizontal="12dp"
                        android:text="0987654321"
                        android:textSize="14sp"
                        android:inputType="phone"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. Phương thức thanh toán -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:text="Phương thức thanh toán"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <RadioGroup
                        android:id="@+id/radioGroupPayment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <RadioButton
                            android:id="@+id/rbCash"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Thanh toán khi đến sân"
                            android:checked="true"
                            android:paddingStart="8dp"
                            android:layout_marginBottom="8dp"/>

                        <RadioButton
                            android:id="@+id/rbWallet"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ví điện tử (giả lập)"
                            android:paddingStart="8dp"
                            android:layout_marginBottom="8dp"/>

                        <RadioButton
                            android:id="@+id/rbCredit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Thẻ tín dụng (giả lập)"
                            android:paddingStart="8dp"/>
                    </RadioGroup>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <View android:layout_width="match_parent" android:layout_height="50dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Nút Xác nhận dính đáy -->
    <LinearLayout
        android:id="@+id/layoutBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="10dp">

        <Button
            android:id="@+id/btnFinalConfirm"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Xác nhận đặt sân"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#007BFF"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

</RelativeLayout>