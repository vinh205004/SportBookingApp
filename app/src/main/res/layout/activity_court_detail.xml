<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Phần nội dung cuộn -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layoutBottomBar"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- 1. HEADER ẢNH BÌA & TOOLBAR -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="280dp">

                <ImageView
                    android:id="@+id/imgCourtDetail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_launcher_background"
                    tools:srcCompat="@tools:sample/backgrounds/scenic" />

                <!-- Overlay gradient để nút bấm rõ hơn -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="@drawable/gradient_top_shadow" />

                <!-- Nút Back và Favorite -->
                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/bg_circle_white_transparent"
                    android:elevation="4dp"
                    android:src="@android:drawable/ic_menu_revert"
                    app:tint="#333333"
                    tools:ignore="SpeakableTextPresentCheck" />

                <ImageButton
                    android:id="@+id/btnFavorite"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="40dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_circle_white_transparent"
                    android:elevation="4dp"
                    android:src="@android:drawable/btn_star_big_off"
                    app:tint="#333333"
                    tools:ignore="SpeakableTextPresentCheck" />
            </RelativeLayout>

            <!-- 2. THẺ THÔNG TIN CHÍNH (Nổi lên trên ảnh) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="-40dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvCourtNameDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sân bóng Thanh Xuân"
                        android:textColor="#212121"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"/>

                    <!-- Địa chỉ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@android:drawable/ic_dialog_map"
                            app:tint="#757575" />

                        <TextView
                            android:id="@+id/tvCourtAddressDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="123 Nguyễn Trãi, Thanh Xuân, HN"
                            android:textColor="#757575"
                            android:textSize="14sp"
                            android:ellipsize="end"
                            android:maxLines="1"/>
                    </LinearLayout>

                    <!-- Rating & Loại sân -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical">

                        <!-- Badge Rating -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_rating"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@android:drawable/star_on"
                                app:tint="#FFFFFF"/>

                            <TextView
                                android:id="@+id/tvRatingDetail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="4.5"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="•"
                            android:textColor="#BDBDBD"/>

                        <TextView
                            android:id="@+id/tvCourtTypeDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Sân 7 người"
                            android:textColor="#007BFF"
                            android:background="@drawable/bg_badge_blue_light"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. THỐNG KÊ (Dạng cuộn ngang giống Chips) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="24dp"
                android:paddingStart="16dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Giá -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="100dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_card_info_item"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_compass"
                            app:tint="#007BFF"/>

                        <TextView
                            android:id="@+id/tvPriceDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="150K"
                            android:textColor="#212121"
                            android:textStyle="bold"
                            android:textSize="16sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Giá/giờ"
                            android:textColor="#757575"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <!-- Giờ mở cửa -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="100dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_card_info_item"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_recent_history"
                            app:tint="#4CAF50"/>

                        <TextView
                            android:id="@+id/tvOpenTimeDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="06:00 - 23:00"
                            android:textColor="#212121"
                            android:textStyle="bold"
                            android:textSize="14sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Giờ mở cửa"
                            android:textColor="#757575"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <!-- Wifi -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="100dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_card_info_item"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/stat_sys_data_bluetooth"
                            app:tint="#FF9800"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Miễn phí"
                            android:textColor="#212121"
                            android:textStyle="bold"
                            android:textSize="16sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tiện ích"
                            android:textColor="#757575"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 4. TIỆN ÍCH KHÁC (Chips) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="16dp"
                android:text="Tiện ích sân"
                android:textColor="#212121"
                android:textSize="18sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="12dp"
                android:paddingStart="16dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Chip 1 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_gray"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="🅿️ Bãi đỗ xe"
                        android:textColor="#424242"
                        android:layout_marginEnd="8dp"/>

                    <!-- Chip 2 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_gray"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="🥤 Canteen"
                        android:textColor="#424242"
                        android:layout_marginEnd="8dp"/>

                    <!-- Chip 3 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_gray"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="🚿 Phòng tắm"
                        android:textColor="#424242"
                        android:layout_marginEnd="8dp"/>

                    <!-- Chip 4 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_gray"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="💡 Đèn sáng"
                        android:textColor="#424242"
                        android:layout_marginEnd="8dp"/>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- 5. MÔ TẢ CHI TIẾT -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="16dp"
                android:text="Giới thiệu"
                android:textColor="#212121"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDescriptionDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp"
                android:lineSpacingExtra="6dp"
                android:text="Sân bóng đá cỏ nhân tạo chất lượng cao, nằm ngay trung tâm quận Thanh Xuân. Hệ thống chiếu sáng hiện đại, cỏ mềm tiêu chuẩn FIFA.\n\nPhù hợp cho các trận đấu giao hữu, giải đấu phong trào. Có khu vực chờ mát mẻ cho cổ động viên."
                android:textColor="#616161"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="100dp"/> <!-- Spacer -->
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 6. BOTTOM BAR (THANH ĐẶT SÂN) -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_sheet_top_shadow"
        android:elevation="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đơn giá"
                android:textSize="12sp"
                android:textColor="#757575"/>

            <TextView
                android:id="@+id/tvPriceBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="150.000đ/giờ"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#007BFF"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnBookNow"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:paddingHorizontal="32dp"
            android:backgroundTint="#007BFF"
            android:text="Đặt sân ngay"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:elevation="4dp"/>
    </LinearLayout>

</RelativeLayout>